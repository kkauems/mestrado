<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="field_world">
    <physics name="default_physics" type="dart">
      <dart>
        <collision_detector>bullet</collision_detector>
      </dart>
    </physics>

    <scene>
      <ambient>0.8 0.8 0.8 1.0</ambient>
      <background>0.9 0.9 0.9 1.0</background>
    </scene>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Include the robot model -->
    <model name="fieldbot_instance">
      <include>
        <uri>model://fieldbot</uri>
      </include>
      <pose>0 0 0 0 0 0</pose>
    </model>

  </world>
</sdf>
