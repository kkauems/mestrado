<?xml version="1.0" ?>
<robot name="fieldbot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    Fieldbot Agricultural Robot
    Based on Husky platform
    Dimensions: 0.85m x 0.55m x 0.15m (L x W x H)
    Total Mass: 37.22 kg
  -->

  <!-- Constants -->
  <xacro:property name="chassis_length" value="0.85"/>
  <xacro:property name="chassis_width" value="0.55"/>
  <xacro:property name="chassis_height" value="0.15"/>
  <xacro:property name="wheel_radius" value="0.165"/>
  <xacro:property name="wheel_width" value="0.13"/>
  <xacro:property name="wheelbase" value="0.445"/>
  <xacro:property name="track" value="0.70"/>

  <!-- Mass distribution -->
  <xacro:property name="chassis_mass" value="11.78"/>
  <xacro:property name="wheel_mass" value="3.25"/>
  <xacro:property name="motor_mass" value="0.79"/>
  <xacro:property name="battery_mass" value="4.0"/>

  <!-- Base link (chassis center) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <inertia
        ixx="${(1/12) * chassis_mass * (chassis_width**2 + chassis_height**2)}"
        iyy="${(1/12) * chassis_mass * (chassis_length**2 + chassis_height**2)}"
        izz="${(1/12) * chassis_mass * (chassis_length**2 + chassis_width**2)}"
        ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>

  <!-- Battery link (mounted on chassis) -->
  <link name="battery_link">
    <visual>
      <origin xyz="0 0 ${-chassis_height/2 - 0.02}" rpy="0 0 0"/>
      <geometry>
        <box size="0.3 0.2 0.05"/>
      </geometry>
      <material name="red">
        <color rgba="0.8 0.1 0.1 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="${battery_mass}"/>
      <inertia
        ixx="0.001" iyy="0.001" izz="0.001"
        ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>

  <joint name="battery_joint" type="fixed">
    <parent link="base_link"/>
    <child link="battery_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Front left wheel -->
  <link name="wheel_front_left">
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${wheel_mass}"/>
      <inertia
        ixx="${(1/4) * wheel_mass * (wheel_radius**2) + (1/12) * wheel_mass * (wheel_width**2)}"
        iyy="${(1/2) * wheel_mass * (wheel_radius**2)}"
        izz="${(1/4) * wheel_mass * (wheel_radius**2) + (1/12) * wheel_mass * (wheel_width**2)}"
        ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>

  <joint name="wheel_front_left_joint" type="revolute">
    <parent link="base_link"/>
    <child link="wheel_front_left"/>
    <origin xyz="${wheelbase/2} ${track/2} ${-chassis_height/2 - wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1000" upper="1000" effort="100" velocity="10"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>

  <!-- Front right wheel -->
  <link name="wheel_front_right">
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${wheel_mass}"/>
      <inertia
        ixx="${(1/4) * wheel_mass * (wheel_radius**2) + (1/12) * wheel_mass * (wheel_width**2)}"
        iyy="${(1/2) * wheel_mass * (wheel_radius**2)}"
        izz="${(1/4) * wheel_mass * (wheel_radius**2) + (1/12) * wheel_mass * (wheel_width**2)}"
        ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>

  <joint name="wheel_front_right_joint" type="revolute">
    <parent link="base_link"/>
    <child link="wheel_front_right"/>
    <origin xyz="${wheelbase/2} ${-track/2} ${-chassis_height/2 - wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1000" upper="1000" effort="100" velocity="10"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>

  <!-- Rear left wheel -->
  <link name="wheel_rear_left">
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${wheel_mass}"/>
      <inertia
        ixx="${(1/4) * wheel_mass * (wheel_radius**2) + (1/12) * wheel_mass * (wheel_width**2)}"
        iyy="${(1/2) * wheel_mass * (wheel_radius**2)}"
        izz="${(1/4) * wheel_mass * (wheel_radius**2) + (1/12) * wheel_mass * (wheel_width**2)}"
        ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>

  <joint name="wheel_rear_left_joint" type="revolute">
    <parent link="base_link"/>
    <child link="wheel_rear_left"/>
    <origin xyz="${-wheelbase/2} ${track/2} ${-chassis_height/2 - wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1000" upper="1000" effort="100" velocity="10"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>

  <!-- Rear right wheel -->
  <link name="wheel_rear_right">
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${wheel_mass}"/>
      <inertia
        ixx="${(1/4) * wheel_mass * (wheel_radius**2) + (1/12) * wheel_mass * (wheel_width**2)}"
        iyy="${(1/2) * wheel_mass * (wheel_radius**2)}"
        izz="${(1/4) * wheel_mass * (wheel_radius**2) + (1/12) * wheel_mass * (wheel_width**2)}"
        ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>

  <joint name="wheel_rear_right_joint" type="revolute">
    <parent link="base_link"/>
    <child link="wheel_rear_right"/>
    <origin xyz="${-wheelbase/2} ${-track/2} ${-chassis_height/2 - wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1000" upper="1000" effort="100" velocity="10"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>

  <!-- Camera mount link (for future sensor integration) -->
  <link name="camera_mount">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
      <material name="aluminum">
        <color rgba="0.7 0.7 0.7 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001"
        ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>

  <joint name="camera_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_mount"/>
    <origin xyz="${chassis_length/2} 0 ${chassis_height/2}" rpy="0 0 0"/>
  </joint>

</robot>
